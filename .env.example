# ==============================================================================
# CONFIGURACIÓN GENERAL DEL SISTEMA
# ==============================================================================
APP_NAME="Sistema de Detección de Violencia con IA"
APP_ENV="development"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_STR="/api"

# Configuración del Servidor HTTP
HOST="0.0.0.0"
PORT=8000

# Seguridad y Autenticación JWT (Generar clave segura en producción)
SECRET_KEY="cambiar-esta-clave-secreta-en-produccion-minimo-32-caracteres"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Orígenes Permitidos CORS (separados por coma)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# Base de Datos PostgreSQL
DB_HOST="localhost"
DB_PORT=5432
DB_USER="postgres"
DB_PASSWORD="12345"
DB_NAME="sistema_violencia_db"
DATABASE_URL="postgresql://postgres:12345@localhost:5432/sistema_violencia_db"

# Almacenamiento de Evidencias
STORAGE_DIR="storage"
EVIDENCES_IMAGES_DIR="storage/images"
EVIDENCES_VIDEOS_DIR="storage/videos"
MAX_UPLOAD_SIZE_MB=50

# Configuración de IA y Detección
CONFIDENCE_THRESHOLD=0.5
DEVICE="cpu"
FALL_CONFIRMATION_SECONDS=1.5
INACTIVITY_THRESHOLD_SECONDS=5.0
ALERT_COOLDOWN_SECONDS=10.0
