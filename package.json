{
  "name": "backend-ia",
  "version": "1.0.0",
  "private": true,
  "description": "Backend del Sistema de Detección de Violencia con IA (FastAPI)",
  "scripts": {
    "start": "venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "start:dev": "venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "test": "venv\\Scripts\\pytest.exe -v",
    "db:test": "venv\\Scripts\\python.exe scripts\\test_db_connection.py",
    "db:init": "venv\\Scripts\\python.exe scripts\\init_db.py",
    "db:migrate": "venv\\Scripts\\alembic.exe upgrade head",
    "admin:passwd": "venv\\Scripts\\python.exe scripts\\change_admin_password.py"
  }
}